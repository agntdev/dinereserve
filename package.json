{
  "name": "dinereserve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/bot-toolkit && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-migrate.ts --seed",
    "test:unit": "tsx tests/unit/availability-slots.test.ts"
  },
  "dependencies": {
    "@agntdev/bot-toolkit": "*",
    "grammy": "^1.30.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.2"
  }
}
