[
  {
    "name": "E2T2: non-admin /bookings gets access denied",
    "steps": [
      {
        "send": { "text": "/bookings 2026-06-17" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "This command is only available to restaurant staff."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "E2T2: non-admin pagination callback access denied",
    "steps": [
      {
        "send": { "callback": "bkd:page:1", "messageId": 1 },
        "expect": [
          {
            "method": "answerCallbackQuery",
            "payload": {
              "text": "Only staff can manage bookings."
            }
          }
        ]
      }
    ]
  }
]