[
  {
    "name": "E2T1: non-admin /bookings_today gets access denied",
    "steps": [
      {
        "send": { "text": "/bookings_today" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "This command is only available to restaurant staff."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "E2T1: non-admin booking callback gets access denied",
    "steps": [
      {
        "send": { "callback": "bkt:ns:ABC123", "messageId": 1 },
        "expect": [
          {
            "method": "answerCallbackQuery",
            "payload": {
              "text": "Only staff can manage bookings."
            }
          }
        ]
      }
    ]
  }
]