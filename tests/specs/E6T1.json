[
  {
    "name": "E6T1: /setup starts first-run admin registration",
    "steps": [
      {
        "send": { "text": "/setup" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Welcome to DineReserve setup! Let's configure your restaurant.\n\nFirst, register yourself as the restaurant admin:"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "E6T1: setup flow collects timezone, hours, tables, and saves",
    "steps": [
      {
        "send": { "text": "/setup" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "setup:register:1", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Select your restaurant timezone:"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:tz:America/New_York", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Select opening time:"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:open:11:0", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Select closing time:"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:close:22:0", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "How many tables does the restaurant have?"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:tables:4", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "How many seats per table?"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:seats:4", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Review your restaurant setup:\n\nAdmin: Test (ID 1)\nTimezone: America/New_York\nHours: 11:00 – 22:00\nTables: 4 × 4 seats\n\nSave these settings?"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      },
      {
        "send": { "callback": "setup:save", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "✅ Setup complete! Your restaurant is ready.\n\nReview your restaurant setup:\n\nAdmin: Test (ID 1)\nTimezone: America/New_York\nHours: 11:00 – 22:00\nTables: 4 × 4 seats\n\nSave these settings?"
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      }
    ]
  },
  {
    "name": "E6T1: setup can be cancelled",
    "steps": [
      {
        "send": { "text": "/setup" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "setup:cancel", "messageId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Setup cancelled. Send /setup to start again."
            }
          },
          { "method": "answerCallbackQuery" }
        ]
      }
    ]
  }
]