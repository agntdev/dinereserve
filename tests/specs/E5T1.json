[
  {
    "name": "E5T1: no due reminders before booking",
    "steps": [
      {
        "send": { "text": "/reminders" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "No reminders are due for your bookings right now."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "E5T1: delivers reminder after booking confirmation",
    "steps": [
      {
        "send": { "text": "/reserve" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "cal:date:2026-06-20", "messageId": 1 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "party:4", "messageId": 2 },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": { "callback": "slot:19:00", "messageId": 2 },
        "expect": [{ "method": "editMessageText" }, { "method": "sendMessage" }]
      },
      {
        "send": { "callback": "guest:skip", "messageId": 4 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "guest:skip", "messageId": 5 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "confirm:yes", "messageId": 6 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "text": "/reminders" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Reminder: your reservation is coming up.\n\nReference: 5MNPWV\n\nSaturday, June 20, 2026 at 19:00\n4 guests — Table 2 (4 seats)\nName: Not provided",
              "reply_markup": {
                "inline_keyboard": [
                  [
                    {
                      "text": "Reschedule",
                      "callback_data": "booking:reschedule:5MNPWV"
                    },
                    {
                      "text": "Cancel booking",
                      "callback_data": "booking:cancel:5MNPWV"
                    }
                  ]
                ]
              }
            }
          },
          {
            "method": "sendMessage",
            "payload": {
              "text": "Delivered 1 reservation reminder."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "E5T1: second reminders call reports none due",
    "steps": [
      {
        "send": { "text": "/reserve" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "cal:date:2026-06-20", "messageId": 1 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "party:4", "messageId": 2 },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": { "callback": "slot:19:00", "messageId": 2 },
        "expect": [{ "method": "editMessageText" }, { "method": "sendMessage" }]
      },
      {
        "send": { "callback": "guest:skip", "messageId": 4 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "guest:skip", "messageId": 5 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "confirm:yes", "messageId": 6 },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "text": "/reminders" },
        "expect": [{ "method": "sendMessage" }, { "method": "sendMessage" }]
      },
      {
        "send": { "text": "/reminders" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "No reminders are due for your bookings right now."
            }
          }
        ]
      }
    ]
  }
]