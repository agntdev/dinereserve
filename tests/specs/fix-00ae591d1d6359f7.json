  {
    "name": "entering an invalid date shows error",
    "steps": [
      {
        "send": { "text": "/reserve" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "I'll help you book a table. Please enter the date you'd like to reserve (YYYY-MM-DD format, e.g. 2026-06-20):" } }
        ]
      },
      {
        "send": { "text": "not-a-date" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please enter a valid date in YYYY-MM-DD format (e.g. 2026-06-20):" } }
        ]
      }
    ]
  },
  {
    "name": "entering a past date shows error",
    "steps": [
      {
        "send": { "text": "/reserve" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "I'll help you book a table. Please enter the date you'd like to reserve (YYYY-MM-DD format, e.g. 2026-06-20):" } }
        ]
      },
      {
        "send": { "text": "2020-01-01" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You can't book in the past. Please enter a future date (YYYY-MM-DD):" } }
        ]
      }
    ]
  },
  {
    "name": "entering zero party size shows error",
    "steps": [
      {
        "send": { "text": "/reserve" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "I'll help you book a table. Please enter the date you'd like to reserve (YYYY-MM-DD format, e.g. 2026-06-20):" } }
        ]
      },
      {
        "send": { "text": "2026-12-25" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "How many people? Please enter the party size (e.g. 2):" } }
        ]
      },
      {
        "send": { "text": "0" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please enter a valid party size between 1 and 20:" } }
