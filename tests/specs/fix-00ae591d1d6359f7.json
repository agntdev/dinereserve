      {
        "send": { "text": "/reserve" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "I'll help you book a table. Please enter the date you'd like to reserve (YYYY-MM-DD format, e.g. 2026-06-20):" } }
        ]
      }
    ]
  },
  {
    "name": "entering a valid date asks for party size",
    "steps": [
      {
        "send": { "text": "/reserve" },
